{
  "name": "demo-iv-ac",
  "description": "Using IV and AC in an Ionic app",
  "version": "1.0.0",
  "author": {
    "name": "Ionic Customer Success Team",
    "email": "support@ionic.io",
    "url": "https://ionic.io"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "android": "cap open android",
    "assets": "capacitor-assets generate --iconBackgroundColor '#f1ebe1' --splashBackgroundColor '#f1ebe1' --iconBackgroundColorDark '#110b00' --splashBackgroundColorDark '#110b00'",
    "build": "tsc && vite build && cap sync",
    "dev": "vite",
    "ios": "cap open ios",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:dev": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.1",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.1",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/privacy-screen": "^2.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@hookform/resolvers": "~5.2.2",
    "@ionic-enterprise/auth": "~8.0.0",
    "@ionic-enterprise/identity-vault": "~6.0.4",
    "@ionic/react": "^8.7.17",
    "@ionic/react-router": "^8.7.17",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "axios": "~1.13.3",
    "ionicons": "^8.0.13",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "~7.71.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "yup": "~1.7.1"
  },
  "devDependencies": {
    "@capacitor/assets": "~3.0.5",
    "@capacitor/cli": "^8.0.1",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "~5.1.2",
    "cypress": "~15.9.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.1.0",
    "jsdom": "~27.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "~4.0.18"
  }
}
